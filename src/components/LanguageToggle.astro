---
/**
 * Language toggle component for switching between Turkish and English.
 *
 * Route map:
 *   /                     <-> /en/
 *   /takvim               <-> /en/calendar
 *   /takvim/hafta/:id     <-> /en/calendar/week/:id
 *   /takvim/mekanlar      <-> /en/calendar/venues
 */
import type { Language } from '../i18n/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;

// Normalize path by removing trailing slash (except for root)
function normalizePath(path: string): string {
  if (path === '/' || path === '') return '/';
  return path.replace(/\/$/, '');
}

const trToEn: Array<[RegExp, string]> = [
  [/^\/takvim\/hafta\/([^/]+)$/, '/en/calendar/week/$1'],
  [/^\/takvim\/mekanlar$/, '/en/calendar/venues'],
  [/^\/takvim$/, '/en/calendar'],
];

const enToTr: Array<[RegExp, string]> = [
  [/^\/calendar\/week\/([^/]+)$/, '/takvim/hafta/$1'],
  [/^\/calendar\/venues$/, '/takvim/mekanlar'],
  [/^\/calendar$/, '/takvim'],
];

// Calculate paths for language switch
function getAlternatePath(targetLang: Language): string {
  const normalizedPath = normalizePath(currentPath);

  if (targetLang === 'tr') {
    if (!normalizedPath.startsWith('/en')) return normalizedPath;
    const pathWithoutPrefix = normalizedPath.replace(/^\/en/, '');
    if (pathWithoutPrefix === '' || pathWithoutPrefix === '/') return '/';
    for (const [pattern, replacement] of enToTr) {
      if (pattern.test(pathWithoutPrefix)) return pathWithoutPrefix.replace(pattern, replacement);
    }
    return pathWithoutPrefix;
  }

  if (normalizedPath.startsWith('/en')) return normalizedPath;
  if (normalizedPath === '/') return '/en/';
  for (const [pattern, replacement] of trToEn) {
    if (pattern.test(normalizedPath)) return normalizedPath.replace(pattern, replacement);
  }
  return `/en${normalizedPath}`;
}
---

<div class="flex items-center gap-1 text-sm">
  <a
    href={getAlternatePath('tr')}
    class:list={[
      "px-2 py-1 transition-colors",
      lang === 'tr'
        ? "bg-cereyan-red/15 text-cereyan-red-dark font-medium"
        : "text-text-muted hover:text-text"
    ]}
  >
    TR
  </a>
  <span class="text-border">/</span>
  <a
    href={getAlternatePath('en')}
    class:list={[
      "px-2 py-1 transition-colors",
      lang === 'en'
        ? "bg-cereyan-red/15 text-cereyan-red-dark font-medium"
        : "text-text-muted hover:text-text"
    ]}
  >
    EN
  </a>
</div>
