---
import HomeLayout from '../../layouts/HomeLayout.astro';
---

<HomeLayout lang="en" altPath="/">
  <header class="mb-16">
    <h1 class="wordmark text-4xl sm:text-5xl text-cereyan-red-dark mb-5">Cereyan</h1>
    <p class="text-base text-text">Production. Restoration. Events. Consulting.</p>
  </header>

  <section class="mb-16">
    <a
      href="/en/calendar"
      class="block bg-cereyan-red text-cereyan-alabaster p-6 sm:p-8 hover:bg-cereyan-red-dark transition-colors"
    >
      <span class="block text-[11px] tracking-widest uppercase mb-2 text-cereyan-black">Updated weekly</span>
      <span class="block font-display text-3xl sm:text-4xl leading-tight">Istanbul Film Calendar</span>
      <span class="block mt-3 text-sm">Festivals, the cinematheque, one-off screenings. Every screen in the city on one calendar.</span>
    </a>
  </section>

  <section class="mb-20">
    <h2 class="text-xs tracking-widest-xl uppercase text-text-muted mb-4">Current projects</h2>
    <ul class="space-y-3">
      <li>
        <a
          href="/en/calendar"
          class="font-display text-lg underline decoration-cereyan-red/40 underline-offset-4 hover:decoration-cereyan-red hover:text-cereyan-red-dark"
        >
          Istanbul Film Calendar
        </a>
      </li>
      <li>
        <a
          href="https://cereyan.substack.com"
          class="font-display text-lg underline decoration-cereyan-red/40 underline-offset-4 hover:decoration-cereyan-red hover:text-cereyan-red-dark"
        >
          Newsletter
        </a>
      </li>
    </ul>
  </section>

  <footer class="text-xs text-text-muted">
    <a href="mailto:iletisim@cereyan.xyz" class="hover:text-cereyan-red-dark">iletisim@cereyan.xyz</a>
    <span class="mx-2">·</span>
    <a href="https://instagram.com/cereyanistanbul" class="hover:text-cereyan-red-dark">Instagram</a>
  </footer>
</HomeLayout>
