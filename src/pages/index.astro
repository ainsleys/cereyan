---
import HomeLayout from '../layouts/HomeLayout.astro';
---

<HomeLayout lang="tr" altPath="/en/">
  <header class="mb-16">
    <h1 class="wordmark text-4xl sm:text-5xl text-cereyan-red-dark mb-5">Cereyan</h1>
    <p class="text-base text-text">Yapım. Restorasyon. Etkinlik. Danışmanlık.</p>
  </header>

  <section class="mb-16">
    <a
      href="/takvim"
      class="block bg-cereyan-red text-cereyan-alabaster p-6 sm:p-8 hover:bg-cereyan-red-dark transition-colors"
    >
      <span class="block text-[11px] tracking-widest uppercase mb-2 text-cereyan-black">Her hafta güncel</span>
      <span class="block font-display text-3xl sm:text-4xl leading-tight">İstanbul Film Takvimi</span>
      <span class="block mt-3 text-sm">Festival, sinematek, özel gösterim. Şehrin bütün perdeleri tek takvimde.</span>
    </a>
  </section>

  <section class="mb-20">
    <h2 class="text-xs tracking-widest-xl uppercase text-text-muted mb-4">Güncel projeler</h2>
    <ul class="space-y-3">
      <li>
        <a
          href="/takvim"
          class="font-display text-lg underline decoration-cereyan-red/40 underline-offset-4 hover:decoration-cereyan-red hover:text-cereyan-red-dark"
        >
          İstanbul Film Takvimi
        </a>
      </li>
      <li>
        <a
          href="/denize-inen-sokak/"
          class="font-display text-lg underline decoration-cereyan-red/40 underline-offset-4 hover:decoration-cereyan-red hover:text-cereyan-red-dark"
        >
          Denize İnen Sokak
        </a>
      </li>
      <li>
        <a
          href="https://cereyan.substack.com"
          class="font-display text-lg underline decoration-cereyan-red/40 underline-offset-4 hover:decoration-cereyan-red hover:text-cereyan-red-dark"
        >
          Bülten
        </a>
      </li>
    </ul>
  </section>

  <footer class="text-xs text-text-muted">
    <a href="mailto:iletisim@cereyan.xyz" class="hover:text-cereyan-red-dark">iletisim@cereyan.xyz</a>
    <span class="mx-2">·</span>
    <a href="https://instagram.com/cereyanistanbul" class="hover:text-cereyan-red-dark">Instagram</a>
  </footer>
</HomeLayout>
