---
/**
 * Layout for the Cereyan company pages (/ and /en/).
 * The wordmark rides a slowly moving terracotta river (LiquidHero); below it, one column of type on white.
 */
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import LiquidHero from '../components/LiquidHero.astro';

interface Props {
  lang: 'tr' | 'en';
  /** Path of this page in the other language, for the toggle */
  altPath: string;
}

const { lang, altPath } = Astro.props;
const description =
  lang === 'tr'
    ? 'Sinema kültürü üzerine bağımsız bir oluşum: yapım, restorasyon, etkinlik, danışmanlık. İstanbul film takvimi.'
    : 'An independent organization for film culture: production, restoration, events, consulting. The Istanbul film calendar.';
const canonicalURL = new URL(Astro.url.pathname, 'https://cereyan.xyz');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Cereyan</title>
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content="Cereyan" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://cereyan.xyz/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cereyan" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cereyan.xyz/og.jpg" />
    <link rel="preload" href="/fonts/dm-sans-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-surface">
    <LiquidHero lang={lang} altPath={altPath} />

    <main class="flex-1">
      <div class="w-full max-w-xl mx-auto px-6 py-12 sm:py-16">
        <slot />
      </div>
    </main>
    <Analytics />
  </body>
</html>
